{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnsimTrack Live",
  "version": "0.1.0",
  "identifier": "com.slowlearner.ansimtracklive",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AnsimTrack Live",
        "width": 1440,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
